# ─────────────────────────────────────────
# Analytics 환경변수 (배포 시 실제 값 입력)
# ─────────────────────────────────────────
# 이 파일을 .env.local 로 복사하고 실제 ID로 변경하세요.
#
# Vercel에 배포한다면 Vercel 대시보드 → Project → Settings → Environment Variables 에서 설정.

# Google Analytics 4 ID (analytics.google.com 에서 발급)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager ID (선택, tagmanager.google.com)
NEXT_PUBLIC_GTM_ID=

# ─────────────────────────────────────────
# 검색엔진 사이트 소유 확인 코드 (가장 중요!)
# ─────────────────────────────────────────
# 이 코드가 없으면 네이버/구글 검색결과에 사이트가 안 나옵니다.

# 구글 서치 콘솔 (search.google.com/search-console)
# 속성 추가 → HTML 태그 방식 → content="..." 값만 복사
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# 네이버 서치어드바이저 (searchadvisor.naver.com)
# 사이트 등록 → HTML 태그 → content="..." 값만 복사
NEXT_PUBLIC_NAVER_VERIFICATION=

# ─────────────────────────────────────────
# Admin 페이지 인증 (필수!)
# ─────────────────────────────────────────

# 관리자 로그인 비밀번호 (강력하게 설정)
# 평문 또는 bcrypt 해시 사용 가능
ADMIN_PASSWORD=

# 세션 토큰 비밀키 (32자 이상 랜덤 문자열)
# 생성 명령: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─────────────────────────────────────────
# Supabase (DB 연결)
# ─────────────────────────────────────────
# witheass-admin과 같은 Supabase 프로젝트의 키 사용

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
